async def extract_text_from_pdf(file_content: bytes) -> str:
    """Extract text from PDF using PyPDF"""
    try:
        pdf_reader = pypdf.PdfReader(file_content)
        text = ""
        for page in pdf_reader.pages:
            text += page.extract_text() + "\n"
        return text
    except Exception as e:
        logger.error(f"PDF extraction error: {e}")
        raise HTTPException(status_code=400, detail="Failed to extract PDF text")

async def chunk_text(text: str, chunk_size: int = 2000, overlap: int = 200) -> List[str]:
    """Split text into overlapping chunks for processing"""
    chunks = []
    for i in range(0, len(text), chunk_size - overlap):
        chunks.append(text[i:i + chunk_size])
    return chunks

# ============================================================================
# ENTITY EXTRACTION using Vertex AI
# ============================================================================

async def extract_entities_and_relations(text: str, document_title: str) -> tuple[List[ExtractedEntity], List[ExtractedRelationship]]:
    """
    Use Vertex AI Gemini to extract entities and relationships from academic paper
    """
    
    extraction_prompt = f"""
    Analyze this academic paper and extract the following in JSON format:
    
    {{
        "paper": {{
            "title": "Paper title",
            "abstract": "Brief summary",
            "keywords": ["keyword1", "keyword2"],
            "research_area": "Primary research area"
        }},
        "authors": [
            {{"name": "Author Name", "affiliation": "University/Dept"}}
        ],
        "cited_papers": [
            {{"title": "Cited paper title", "context": "How it's cited"}}
        ],
        "datasets_used": [
            {{"name": "Dataset name", "source": "Source URL/DOI"}}
        ],
        "methodologies": [
            {{"name": "Method", "description": "Brief description"}}
        ],
        "collaborating_authors": [
            {{"author1": "Name1", "author2": "Name2", "papers": 1}}
        ]
    }}
    
    Paper Content:
    {text[:5000]}
    
    Return ONLY valid JSON, no additional text.
    """
    
    try:
        response = model.generate_content(extraction_prompt)
        # Parse the response
        try:
            data = json.loads(response.text)
            
            # Convert to our data models
            entities = []
            relationships = []
            
            # Add paper entity
            if "paper" in data:
                entities.append(ExtractedEntity(
                    entity_type="paper",
                    name=data["paper"].get("title", document_title),
                    metadata={
                        "abstract": data["paper"].get("abstract"),
                        "keywords": data["paper"].get("keywords", []),
                        "research_area": data["paper"].get("research_area"),
                        "ingested_at": datetime.utcnow().isoformat()
                    }
                ))
            
            # Add author entities
            for author in data.get("authors", []):
                entities.append(ExtractedEntity(
                    entity_type="author",
                    name=author["name"],
                    metadata={"affiliation": author.get("affiliation")}
                ))
                
                # Create paper-author relationship
                relationships.append(ExtractedRelationship(
                    source=author["name"],
                    target=document_title,
                    relationship_type="authored",
                    context="Author of this paper"
                ))
            
            # Add cited papers as relationships
            for cited in data.get("cited_papers", []):
                relationships.append(ExtractedRelationship(
                    source=document_title,
                    target=cited["title"],
                    relationship_type="cites",
                    context=cited.get("context", "")
                ))
            
            # Add dataset entities and relationships
            for dataset in data.get("datasets_used", []):
                entities.append(ExtractedEntity(
                    entity_type="dataset",
                    name=dataset["name"],
                    metadata={"source": dataset.get("source")}
                ))
                relationships.append(ExtractedRelationship(
                    source=document_title,
                    target=dataset["name"],
                    relationship_type="uses_dataset",
                    context=""
                ))
            
            # Add methodology entities
            for method in data.get("methodologies", []):
                entities.append(ExtractedEntity(
                    entity_type="methodology",
                    name=method["name"],
                    metadata={"description": method.get("description")}
                ))
                relationships.append(ExtractedRelationship(
                    source=document_title,
                    target=method["name"],
                    relationship_type="uses_methodology",
                    context=""
                ))
            
            return entities, relationships
            
        except json.JSONDecodeError as e:
            logger.error(f"JSON parsing error: {e}, Response: {response.text}")
            return [], []
            
    except Exception as e:
        logger.error(f"Entity extraction error: {e}")
        return [], []

# ============================================================================
# EMBEDDING GENERATION
