def init_database():
    """Initialize AlloyDB schema"""
    schema_sql = """
    -- Create extension for vector search
    CREATE EXTENSION IF NOT EXISTS vector;
    
    -- Papers table
    CREATE TABLE IF NOT EXISTS papers (
        id SERIAL PRIMARY KEY,
        title VARCHAR(500) NOT NULL UNIQUE,
        abstract TEXT,
        department VARCHAR(200),
        keywords TEXT[],
        research_area VARCHAR(200),
        embedding vector(768),
        doi VARCHAR(100),
        ingested_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    -- Authors table
    CREATE TABLE IF NOT EXISTS authors (
        id SERIAL PRIMARY KEY,
        name VARCHAR(300) NOT NULL UNIQUE,
        affiliation VARCHAR(300),
        email VARCHAR(200),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    -- Paper-Author junction
    CREATE TABLE IF NOT EXISTS paper_authors (
        paper_id INT REFERENCES papers(id),
        author_id INT REFERENCES authors(id),
        PRIMARY KEY (paper_id, author_id)
    );
    
    -- Datasets table
    CREATE TABLE IF NOT EXISTS datasets (
        id SERIAL PRIMARY KEY,
        name VARCHAR(300) NOT NULL UNIQUE,
        source VARCHAR(500),
        description TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    -- Relationships/Edges
    CREATE TABLE IF NOT EXISTS relationships (
        id SERIAL PRIMARY KEY,
        source_entity VARCHAR(500) NOT NULL,
        target_entity VARCHAR(500) NOT NULL,
        relationship_type VARCHAR(100) NOT NULL,
        context TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    -- Create indexes
    CREATE INDEX IF NOT EXISTS idx_papers_department ON papers(department);
    CREATE INDEX IF NOT EXISTS idx_papers_embedding ON papers USING ivfflat(embedding vector_cosine_ops);
    CREATE INDEX IF NOT EXISTS idx_relationships_type ON relationships(relationship_type);
    CREATE INDEX IF NOT EXISTS idx_relationships_source ON relationships(source_entity);
    """
    
    try:
        conn = get_db_connection()
        with conn.cursor() as cursor:
            for statement in schema_sql.split(';'):
                if statement.strip():
                    cursor.execute(statement)
            conn.commit()
        logger.info("Database schema initialized")
    except Exception as e:
        logger.error(f"Database initialization error: {e}")

async def save_entities_to_db(entities: List[ExtractedEntity], relationships: List[ExtractedRelationship]):
    """Save extracted entities and relationships to AlloyDB"""
    conn = get_db_connection()
    
    try:
        with conn.cursor() as cursor:
            for entity in entities:
                if entity.entity_type == "paper":
                    cursor.execute("""
                        INSERT INTO papers (title, abstract, keywords, research_area, department)
                        VALUES (%s, %s, %s, %s, %s)
                        ON CONFLICT (title) DO NOTHING
                    """, (
                        entity.name,
                        entity.metadata.get("abstract"),
                        entity.metadata.get("keywords"),
                        entity.metadata.get("research_area"),
                        entity.metadata.get("department")
                    ))
                
                elif entity.entity_type == "author":
                    cursor.execute("""
                        INSERT INTO authors (name, affiliation)
                        VALUES (%s, %s)
                        ON CONFLICT (name) DO NOTHING
                    """, (entity.name, entity.metadata.get("affiliation")))
            
            for rel in relationships:
                cursor.execute("""
                    INSERT INTO relationships (source_entity, target_entity, relationship_type, context)
                    VALUES (%s, %s, %s, %s)
                """, (rel.source, rel.target, rel.relationship_type, rel.context))
        
        conn.commit()
        logger.info(f"Saved {len(entities)} entities and {len(relationships)} relationships")
        
    except Exception as e:
        logger.error(f"Database save error: {e}")
        conn.rollback()
    finally:
        conn.close()

