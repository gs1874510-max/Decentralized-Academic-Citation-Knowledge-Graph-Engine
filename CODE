@app.post("/upload-paper")
async def upload_paper(
    file: UploadFile = File(...),
    title: str = None,
    department: str = None,
    authors: str = None
):
    """
    Upload a PDF paper and process it for the knowledge graph
    """
    try:
        # Read PDF
        file_content = await file.read()
        text = await extract_text_from_pdf(file_content)
        
        # Use filename if title not provided
        doc_title = title or file.filename.replace(".pdf", "")
        
        # Extract entities and relationships
        entities, relationships = await extract_entities_and_relations(text, doc_title)
        
        # Generate embedding for the paper
        abstract = next((e.metadata.get("abstract") for e in entities if e.entity_type == "paper"), text[:500])
        
        # Save to database
        await save_entities_to_db(entities, relationships)
        
        return {
            "status": "success",
            "title": doc_title,
            "entities_extracted": len(entities),
            "relationships_extracted": len(relationships),
            "message": "Paper processed and added to knowledge graph"
        }
        
    except Exception as e:
        logger.error(f"Upload error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/search-collaborations")
async def search_collaborations(author: str = None, department: str = None):
    """
    Find research collaborations and cross-disciplinary connections
    """
    conn = get_db_connection()
    try:
        with conn.cursor() as cursor:
            if author:
                # Find papers by author and their co-authors
                cursor.execute("""
                    SELECT DISTINCT a2.name, COUNT(*) as collaboration_count
                    FROM paper_authors pa1
                    JOIN authors a1 ON pa1.author_id = a1.id
                    JOIN paper_authors pa2 ON pa1.paper_id = pa2.paper_id
                    JOIN authors a2 ON pa2.author_id = a2.id
                    WHERE a1.name = %s AND a2.name != %s
                    GROUP BY a2.name
                    ORDER BY collaboration_count DESC
                """, (author, author))
                
                collaborators = [{"author": row[0], "papers_together": row[1]} for row in cursor.fetchall()]
                return {"author": author, "collaborators": collaborators}
            
            elif department:
                # Find cross-department collaborations
                cursor.execute("""
                    SELECT pa1.paper_id, COUNT(DISTINCT pa1.author_id) as dept1_authors,
                           COUNT(DISTINCT pa2.author_id) as dept2_authors
                    FROM paper_authors pa1
                    JOIN paper_authors pa2 ON pa1.paper_id = pa2.paper_id
                    WHERE pa1.author_id != pa2.author_id
                    LIMIT 20
                """)
                
                collaborations = [
                    {"paper_id": row[0], "authors_involved": row[1] + row[2]}
                    for row in cursor.fetchall()
                ]
                return {"department": department, "collaborations": collaborations}
        
    except Exception as e:
        logger.error(f"Search error: {e}")
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        conn.close()

@app.get("/find-similar-papers")
async def find_similar_papers(paper_title: str, limit: int = 5):
    """
    Find similar papers using embedding similarity
    """
    conn = get_db_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute("""
                SELECT title, 1 - (embedding <=> (
                    SELECT embedding FROM papers WHERE title = %s
                )) as similarity
                FROM papers
                WHERE title != %s
                ORDER BY similarity DESC
                LIMIT %s
            """, (paper_title, paper_title, limit))
            
            similar_papers = [
                {"title": row[0], "similarity_score": float(row[1])}
                for row in cursor.fetchall()
            ]
            return {"query_paper": paper_title, "similar_papers": similar_papers}
        
    except Exception as e:
        logger.error(f"Similarity search error: {e}")
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        conn.close()

