/**
 * Knowledge Graph Visualization Component
 * Uses D3.js and React for interactive graph visualization
 */

import React, { useEffect, useRef, useState } from 'react';
import * as d3 from 'd3';

const GraphVisualization = ({ apiUrl }) => {
  const svgRef = useRef();
  const [nodes, setNodes] = useState([]);
  const [links, setLinks] = useState([]);
  const [loading, setLoading] = useState(false);
  const [filterType, setFilterType] = useState('all');

  // Fetch graph data from API
  const fetchGraphData = async () => {
    if (!apiUrl) {
      alert('Please set API URL first');
      return;
    }

    setLoading(true);
    try {
      // This would need a new endpoint on the backend
      // For now, we'll use mock data to show the structure
      const mockNodes = [
        { id: 'John Doe', type: 'author', group: 'CS' },
        { id: 'Jane Smith', type: 'author', group: 'CS' },
        { id: 'Bob Johnson', type: 'author', group: 'Biology' },
        { id: 'Deep Learning 2024', type: 'paper', group: 'CS' },
        { id: 'Gene Editing Methods', type: 'paper', group: 'Biology' },
        { id: 'ImageNet', type: 'dataset', group: 'CS' },
        { id: 'CRISPR', type: 'concept', group: 'Biology' },
      ];

      const mockLinks = [
        { source: 'John Doe', target: 'Deep Learning 2024', type: 'authored' },
        { source: 'Jane Smith', target: 'Deep Learning 2024', type: 'authored' },
        { source: 'John Doe', target: 'Jane Smith', type: 'collaborates' },
        { source: 'Deep Learning 2024', target: 'ImageNet', type: 'uses_dataset' },
        { source: 'Bob Johnson', target: 'Gene Editing Methods', type: 'authored' },
        { source: 'Gene Editing Methods', target: 'CRISPR', type: 'uses_concept' },
      ];

      setNodes(mockNodes);
      setLinks(mockLinks);
    } catch (error) {
      console.error('Error fetching graph data:', error);
    } finally {
      setLoading(false);
    }
  };

  // Initialize D3 visualization
  useEffect(() => {
    if (!svgRef.current || nodes.length === 0) return;

    const svg = d3.select(svgRef.current);
    const width = svg.node().clientWidth;
    const height = svg.node().clientHeight;

    // Clear previous content
    svg.selectAll('*').remove();

    // Define colors for different node types
    const nodeColors = {
      author: '#a78bfa',
      paper: '#60a5fa',
      dataset: '#34d399',
      concept: '#fbbf24',
    };

    // Create force simulation
    const simulation = d3
      .forceSimulation(nodes)
      .force('link', d3.forceLink(links).id((d) => d.id).distance(100))
      .force('charge', d3.forceManyBody().strength(-400))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collision', d3.forceCollide().radius(40));

    // Create SVG elements
    const defs = svg.append('defs');

    // Add marker for arrows
    defs
      .append('marker')
      .attr('id', 'arrowhead')
      .attr('markerWidth', 10)
      .attr('markerHeight', 10)
      .attr('refX', 30)
      .attr('refY', 3)
      .attr('orient', 'auto')
      .append('polygon')
      .attr('points', '0 0, 10 3, 0 6')
      .attr('fill', '#a0aec0');

    // Add links
    const link = svg
      .append('g')
      .selectAll('line')
      .data(links)
      .enter()
      .append('line')
      .attr('stroke', '#64748b')
      .attr('stroke-opacity', 0.5)
      .attr('stroke-width', 2)
      .attr('marker-end', 'url(#arrowhead)');

    // Add link labels
    const linkLabels = svg
      .append('g')
      .selectAll('text')
      .data(links)
      .enter()
      .append('text')
      .attr('font-size', '11px')
      .attr('fill', '#94a3b8')
      .attr('text-anchor', 'middle')
      .text((d) => d.type);

    // Add nodes
    const node = svg
      .append('g')
      .selectAll('circle')
      .data(nodes)
      .enter()
      .append('circle')
      .attr('r', (d) => (d.type === 'paper' ? 15 : 10))
      .attr('fill', (d) => nodeColors[d.type] || '#6b7280')
      .attr('stroke', '#1f2937')
      .attr('stroke-width', 2)
      .style('cursor', 'pointer')
      .call(drag(simulation));

    // Add node labels
    const labels = svg
      .append('g')
      .selectAll('text')
      .data(nodes)
      .enter()
      .append('text')
      .attr('font-size', '11px')
      .attr('fill', '#e2e8f0')
      .attr('text-anchor', 'middle')
      .attr('dy', '.35em')
      .style('pointer-events', 'none')
      .style('font-weight', 'bold')
      .text((d) => (d.id.length > 15 ? d.id.substring(0, 12) + '...' : d.id));

    // Add tooltip
    const tooltip = d3
      .select('body')
      .append('div')
      .style('position', 'absolute')
      .style('background', '#1e293b')
      .style('color', '#e2e8f0')
      .style('padding', '8px 12px')
      .style('border-radius', '6px')
      .style('border', '1px solid #475569')
      .style('font-size', '12px')
      .style('pointer-events', 'none')
      .style('opacity', 0);

    node.on('mouseover', (event, d) => {
      tooltip
        .style('opacity', 1)
        .text(`${d.id} (${d.type})`)
        .style('left', event.pageX + 10 + 'px')
        .style('top', event.pageY - 10 + 'px');

      // Highlight connected nodes
      link.style('stroke-opacity', (l) =>
        l.source === d || l.target === d ? 0.8 : 0.2
      );
      node.style('opacity', (n) =>
        n === d || links.some((l) => (l.source === d && l.target === n) || (l.target === d && l.source === n)) ? 1 : 0.3
      );
    }).on('mouseout', () => {
      tooltip.style('opacity', 0);
      link.style('stroke-opacity', 0.5);
      node.style('opacity', 1);
    });

    // Drag function
    function drag(simulation) {
      function dragstarted(event, d) {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x;
        d.fy = d.y;
      }

      function dragged(event, d) {
        d.fx = event.x;
        d.fy = event.y;
      }

      function dragended(event, d) {
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null;
        d.fy = null;
      }

      return d3
        .drag()
        .on('start', dragstarted)
        .on('drag', dragged)
        .on('end', dragended);
    }

    // Update positions on simulation tick
    simulation.on('tick', () => {
      link
        .attr('x1', (d) => d.source.x)
        .attr('y1', (d) => d.source.y)
        .attr('x2', (d) => d.target.x)
        .attr('y2', (d) => d.target.y);

      linkLabels
        .attr('x', (d) => (d.source.x + d.target.x) / 2)
        .attr('y', (d) => (d.source.y + d.target.y) / 2);

      node.attr('cx', (d) => d.x).attr('cy', (d) => d.y);

      labels.attr('x', (d) => d.x).attr('y', (d) => d.y);
    });

    // Cleanup
    return () => {
      simulation.stop();
      tooltip.remove();
    };
  }, [nodes, links]);

  return (
    <div className="w-full h-full flex flex-col bg-slate-900">
      {/* Controls */}
      <div className="p-4 bg-slate-800 border-b border-purple-500/20">
        <div className="flex gap-4 items-center">
          <button
            onClick={fetchGraphData}
            disabled={loading}
            className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50 transition"
          >
            {loading ? 'Loading...' : 'Refresh Graph'}
          </button>

          <div className="flex gap-2">
            {['all', 'author', 'paper', 'dataset'].map((type) => (
              <button
                key={type}
                onClick={() => setFilterType(type)}
                className={`px-3 py-1 rounded-lg text-sm transition ${
                  filterType === type
                    ? 'bg-purple-600 text-white'
                    : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                }`}
              >
                {type.charAt(0).toUpperCase() + type.slice(1)}
              </button>
            ))}
          </div>

          <div className="ml-auto text-sm text-slate-400">
            Nodes: {nodes.length} | Links: {links.length}
          </div>
        </div>
      </div>

      {/* Legend */}
      <div className="p-3 bg-slate-800/50 border-b border-purple-500/10 flex gap-6 text-sm">
        {[
          { type: 'author', color: '#a78bfa', label: 'Author' },
          { type: 'paper', color: '#60a5fa', label: 'Paper' },
          { type: 'dataset', color: '#34d399', label: 'Dataset' },
          { type: 'concept', color: '#fbbf24', label: 'Concept' },
        ].map((item) => (
          <div key={item.type} className="flex items-center gap-2">
            <div
              className="w-3 h-3 rounded-full"
              style={{ backgroundColor: item.color }}
            />
            <span className="text-slate-300">{item.label}</span>
          </div>
        ))}
      </div>

      {/* Visualization */}
      <div className="flex-1 relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        <svg
          ref={svgRef}
          style={{ width: '100%', height: '100%' }}
          className="bg-slate-900"
        />

        {nodes.length === 0 && !loading && (
          <div className="absolute inset-0 flex items-center justify-center">
            <div className="text-center">
              <p className="text-slate-400 mb-4">No graph data loaded</p>
              <button
                onClick={fetchGraphData}
                className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700"
              >
                Load Sample Graph
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Stats Panel */}
      {nodes.length > 0 && (
        <div className="p-4 bg-slate-800 border-t border-purple-500/20 grid grid-cols-4 gap-4 text-sm">
          <div>
            <p className="text-slate-400">Authors</p>
            <p className="text-xl font-bold text-purple-400">
              {nodes.filter((n) => n.type === 'author').length}
            </p>
          </div>
          <div>
            <p className="text-slate-400">Papers</p>
            <p className="text-xl font-bold text-blue-400">
              {nodes.filter((n) => n.type === 'paper').length}
            </p>
          </div>
          <div>
            <p className="text-slate-400">Datasets</p>
            <p className="text-xl font-bold text-emerald-400">
              {nodes.filter((n) => n.type === 'dataset').length}
            </p>
          </div>
          <div>
            <p className="text-slate-400">Relationships</p>
            <p className="text-xl font-bold text-amber-400">{links.length}</p>
          </div>
        </div>
      )}
    </div>
  );
};

export default GraphVisualization;
