import uvicorn
from fastapi import FastAPI
app = FastAPI(title="Knowledge Graph Engine")
@app.get("/")
def root():
    return {"status": "Academic Knowledge Graph Engine - RUNNING"}
@app.get("/health")
def health():
    return {"status": "healthy"}
@app.get("/stats")
def stats():
    return {
        "papers": 0,
        "authors": 0,
        "relationships": 0
    }
if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8080)
